---
export interface Props {
	title: string
	placeName: string
	address: string
	date: string
	time: string
	locationUrl: string
}
const { title, placeName, address, date, time, locationUrl } = Astro.props
---

<>
	<div class="grid grid-cols-1">
		<div
			data-animate="fade-down"
			class="mb-6 flex items-center gap-4"
		>
			<div class="h-px w-full animate-line" style="background: linear-gradient(to right, transparent, #c8956c40);"></div>
			<p class="text-4xl satisfy shrink-0 max-w-[60%] overflow-visible" style="color: #f5e6d3;">
				<span class="overflow-visible">{title}</span>
			</p>
			<div class="h-px w-full animate-line" style="background: linear-gradient(to left, transparent, #c8956c40);"></div>
		</div>
		<p class="mb-1 font-bold text-lg" data-animate="fade-up" data-animate-delay="100" style="color: #e8d5b7;">
			{placeName}
		</p>
		<p class="mb-1" data-animate="fade-up" data-animate-delay="150" style="color: #b0a8b8;">
			<svg width="18" height="18" style="color: #c8956c;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="inline-block align-middle"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 11h18"/></svg>
			{date}
		</p>
		<p class="mb-1" data-animate="fade-up" data-animate-delay="200" style="color: #b0a8b8;">
			<svg width="18" height="18" style="color: #c8956c;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="inline-block align-middle"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></svg>
			{time}
		</p>

		<p
			class="text-sm mb-1 overflow-visible"
			data-animate="fade-up"
			data-animate-delay="250"
			style="color: #8a8494;"
		>
			<svg width="18" height="18" style="color: #c8956c;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="inline-block align-middle"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
			<span class="overflow-visible">{address}</span>
		</p>
		<div class="mt-6" data-animate="zoom-in" data-animate-delay="350">
			<a
				href={locationUrl}
				type="button"
				class="animate-hover inline-block transition-all duration-300 outline-none h-10 px-6 text-sm rounded-full"
				style="color: #f5e6d3; border: 1px solid #c8956c50; background: rgba(200,149,108,0.08);"
				target="_blank"
				><span
					class="flex items-center h-full w-full justify-center gap-1 flex-nowrap whitespace-nowrap"
				>
					<svg width="18" height="18" style="color: #c8956c;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="inline-block align-middle"><path d="m3 5 6-2 6 2 6-2v16l-6 2-6-2-6 2V5Zm6-2v16m6-14v16"/></svg>
					 Open Map</span
				></a
			>
		</div>
	</div>
</>
