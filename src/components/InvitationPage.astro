---
import OpenInvitationButton from '../components/OpenInvitationButton.svelte'
import cover from '../assets/cover.avif'
---


<div class="invitation-cover relative overflow-hidden bg-slate-900">
    <div class="absolute inset-0">
        <img
            data-cover-image
            src={cover.src}
            alt="Yohanes and Citra"
            width={cover.width}
            height={cover.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover mx-auto max-w-screen-md md:max-w-screen-sm"
        />
    </div>

    <div class="absolute inset-0 pointer-events-none cover-shade" aria-hidden="true"></div>
    <div data-cover-copy class="invitation-cover relative flex flex-col flex-wrap justify-end text-white">
        <div class="flex flex-col items-center content-center py-8">
            <div class="satisfy text-center text-5xl font-bold" data-cover-detail>Yohanes & Citra</div>
            <div data-cover-rule class="cover-rule" aria-hidden="true"></div>
            <div class="text-center mx-8 p-3" data-cover-detail>
                <p class="text-xs">Dear, </p>
                <h5 id="guest-name" class="text-base font-bold overflow-visible"></h5>
            </div>
            <div data-cover-detail>
                <OpenInvitationButton client:load />
            </div>
        </div>
    </div>
</div>

<script>
    const name = new URLSearchParams(window.location.search).get('to')
    const el = document.getElementById('guest-name')
    if (el && name) el.textContent = name
</script>