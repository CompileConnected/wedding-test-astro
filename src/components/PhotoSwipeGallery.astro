---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

export interface Props {
	images: ImageMetadata[]
}

const { images } = Astro.props
---

<div
	class="gallery-animate grid grid-cols-2 sm:grid-cols-3 gap-2 content-around pt-[2rem] px-8"
	id="pswp-gallery"
>
	{
		images.map((image, index) => (
			<a href={image.src}
			
				data-pswp-width={image.width}
				data-pswp-height={image.height}
				target="_blank"
				class="gallery-item rounded-lg overflow-hidden"
			>
				<Image src={image} width={320} widths={[160, 240, 320, 480, 640]} sizes="(min-width: 768px) 160px, (min-width: 640px) calc((100vw - 80px) / 3), calc((100vw - 72px) / 2)" format="avif" alt={`Yohanes and Citra — wedding photo ${index + 1}`} loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" />
			</a>
		))
	}
</div>
